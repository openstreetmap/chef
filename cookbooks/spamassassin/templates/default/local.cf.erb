# DO NOT EDIT - This file is being maintained by Chef

# Set the threshold at which a message is considered spam
required_score 5.0

# Set which networks or hosts are considered 'trusted'
trusted_networks <%= @trusted_networks.join(" ") %>

# Turn on the automatic white list
use_auto_whitelist 1

# Set the location for our state files
bayes_path /var/spool/spamassassin/bayes
auto_welcomelist_path /var/spool/spamassassin/auto_welcomelist

# Block some unwanted addresses                     
blocklist_from *@bewertungskanzlei.de
blocklist_from *@revieweraser-sales.com

# Welcome mail from openstreetmap.org from trusted machines
<% @trusted_networks.each do |network| -%>
welcomelist_from_rcvd *@openstreetmap.org [<%= network %>]
<% end -%>
