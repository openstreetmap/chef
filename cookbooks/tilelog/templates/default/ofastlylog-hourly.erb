#!/bin/sh
set -e

export AWS_ACCESS_KEY_ID="<%= @aws_credentials["tilelog_access_key_id"] %>"
export AWS_SECRET_ACCESS_KEY="<%= @aws_credentials["tilelog_secret_access_key"] %>"
export AWS_REGION="eu-north-1"

/opt/ofastlylog/bin/ofastlylog process hourly --hours 6 \
--raster success --vector success --nominatim success --website success
